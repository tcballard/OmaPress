{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tcballard/OmaPress/schemas/article.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "series",
    "status",
    "slug"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "title": {
      "type": "string"
    },
    "series": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 100
    },
    "status": {
      "enum": [
        "draft",
        "ready",
        "published"
      ]
    },
    "published_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "updated_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "summary": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 100
    },
    "header_image": {
      "type": [
        "string",
        "null"
      ]
    },
    "x_caption": {
      "type": "string"
    },
    "x_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_window": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "starts_at",
        "ends_at"
      ],
      "properties": {
        "starts_at": {
          "type": "string",
          "format": "date-time"
        },
        "ends_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
