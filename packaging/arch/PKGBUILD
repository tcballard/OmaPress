# Maintainer: Tom Ballard (tcballard)
pkgname=omapress
pkgver=0.1.0rc1.r20260919
_commit=5a2a681598d41a45d6b732cfa6be80045b40671c
pkgrel=3
pkgdesc='Native local-first publishing for Omarchy'
arch=('x86_64')
url='https://github.com/tcballard/OmaPress'
license=('MIT')
depends=('glibc' 'libgcc' 'libstdc++' 'bash' 'hicolor-icon-theme' 'qt6-base' 'qt6-declarative' 'qt6-wayland' 'git' 'github-cli' 'curl' 'libsecret' 'xdg-utils')
optdepends=('python: register the optional Substack browser companion' 'chromium: optional Substack browser companion')
conflicts=('pressroom')
replaces=('pressroom')
options=('!debug')
makedepends=('rust' 'cmake')
checkdepends=('python' 'desktop-file-utils')
# Development snapshot: immutable source, not an upstream stable release.
source=("$pkgname-$_commit.tar.gz::https://codeload.github.com/tcballard/OmaPress/tar.gz/$_commit")
sha256sums=('66ce71f0a13f106d82f6885bbc5b1951d063066c27803eb1170f0199613b91f3')
build() {
  cd "OmaPress-$_commit"
  cargo build --release --locked
  cmake -S desktop -B build/desktop -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_SKIP_RPATH=ON
  cmake --build build/desktop --parallel 2
}
check() {
  cd "OmaPress-$_commit"
  cargo test --workspace --locked
  cargo build --workspace --locked
  python tests/scheduling.py
  python tests/substack_gateway.py
  python tests/distribution.py
  python tests/deployment.py
  python tests/preview_http.py
  desktop-file-validate desktop/resources/omapress.desktop
}
package() {
  cd "OmaPress-$_commit"
  DESTDIR="$pkgdir" cmake --install build/desktop
  install -Dm755 target/release/omapress "$pkgdir/usr/bin/omapress"
  install -Dm755 scripts/omapress-companion "$pkgdir/usr/bin/omapress-companion"
  install -Dm755 scripts/install-companion.py "$pkgdir/usr/share/omapress/install-companion.py"
  install -d "$pkgdir/usr/share/omapress/companion"
  cp -r companion/* "$pkgdir/usr/share/omapress/companion/"
  install -d "$pkgdir/usr/share/omapress/worker" "$pkgdir/usr/share/doc/omapress"
  install -m644 deploy/worker/* "$pkgdir/usr/share/omapress/worker/"
  sed -i 's|/usr/local/bin/omapress|/usr/bin/omapress|' "$pkgdir/usr/share/omapress/worker/omapress-worker.service"
  cp -r docs/* "$pkgdir/usr/share/doc/omapress/"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/omapress/LICENSE"
}
