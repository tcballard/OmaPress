# Generate each secret independently with: openssl rand -hex 32
# Copy to .env, chmod 600 .env, and replace every REPLACE value before starting.
NEWSLETTER_DB_PASSWORD=REPLACE_DATABASE_PASSWORD
NEWSLETTER_ADMIN_TOKEN=REPLACE_WITH_RANDOM_ADMIN_TOKEN
NEWSLETTER_SIGNING_KEY=REPLACE_WITH_DISTINCT_RANDOM_SIGNING_KEY
NEWSLETTER_PUBLIC_URL=http://127.0.0.1:8787
NEWSLETTER_TEST_RECIPIENT=you@example.com
NEWSLETTER_TRANSPORT=capture
NEWSLETTER_SENDING_ENABLED=false
NEWSLETTER_SEND_INTERVAL_MS=1000
AWS_REGION=eu-west-2
# Required for SES mode. Prefer a host/task IAM role to static credentials.
NEWSLETTER_SES_CONFIGURATION_SET=
NEWSLETTER_EVENTS_QUEUE_URL=
NEWSLETTER_EVENTS_TOPIC_ARN=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
