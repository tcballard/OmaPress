[Unit]
Description=Pressroom publishing queue
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/.config/pressroom/worker.env
ExecStart=/usr/local/bin/pressroom worker ${PRESSROOM_PUBLICATION}
TimeoutStartSec=10min
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
