[Unit]
Description=OmaPress publishing queue
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/.config/omapress/worker.env
ExecStart=/usr/local/bin/omapress worker ${OMAPRESS_PUBLICATION}
TimeoutStartSec=10min
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
